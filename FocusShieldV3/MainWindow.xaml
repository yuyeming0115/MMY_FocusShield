<Window x:Class="FocusShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" 
        Title="FocusShield Settings"
        Width="400"
        MinHeight="580"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Visibility="Hidden"
        Background="#FAFAFA"
        Foreground="#222222">

    <Window.Resources>
        <sys:String x:Key="Lang_Msg_Locked" xmlns:sys="clr-namespace:System;assembly=mscorlib">Focus Mode ON</sys:String>
        <sys:String x:Key="Lang_Msg_Unlocked" xmlns:sys="clr-namespace:System;assembly=mscorlib">Focus Mode OFF</sys:String>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 托盘图标 -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                      ToolTipText="FocusShield"
                      MenuActivation="LeftOrRightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Settings" Click="MenuSettings_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="MenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 主内容 -->
        <StackPanel Margin="18,16,18,14">
            
            <!-- ===== 标题栏 ===== -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="{DynamicResource Lang_Title}" 
                           FontSize="20" FontWeight="Bold" Foreground="#222"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,0">
                    <TextBlock Text="v3.0" FontSize="12" Foreground="#AAA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Border x:Name="StatusIndicator" Width="9" Height="9" CornerRadius="4.5" Background="#DDD"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" BlurRadius="4" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                </StackPanel>
            </Grid>

            <Separator Background="#E8E8E8" Margin="0,0,0,14"/>

            <!-- ===== 屏蔽列表区域 ===== -->
            <TextBlock Text="{DynamicResource Lang_Blacklist_Title}" Style="{StaticResource SectionHeader}"/>

            <ListBox Name="LstBlacklist" Height="110" BorderBrush="#DDD" Margin="0,0,0,6" 
                     Background="White" AllowDrop="True" Drop="LstBlacklist_Drop"/>

            <!-- 拖拽热区 -->
            <Grid Margin="0,0,0,8" AllowDrop="True" Drop="LstBlacklist_Drop" Cursor="Hand">
                <Rectangle Stroke="#C8D0DC" StrokeDashArray="4,3" StrokeThickness="1.2"
                           RadiusX="5" RadiusY="5" Fill="#F7F8FC"/>
                <TextBlock Text="{DynamicResource Lang_Drag_Hint}"
                           Foreground="#999" FontSize="11" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Padding="8"/>
            </Grid>

            <!-- 操作按钮行 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="2" Content="- 移除" Click="BtnRemove_Click" FontSize="11"
                        Style="{StaticResource ActionButton}"
                        Background="#FFF2F2" Foreground="#CC3333" BorderBrush="#F0CCCC"/>
                <Button Grid.Column="4" Content="+ 添加" Click="BtnAdd_Click"
                        Style="{StaticResource ActionButton}"
                        Background="#222" Foreground="White" BorderBrush="#222"/>
            </Grid>

            <Separator Background="#EBEBEB" Margin="0,0,0,14"/>

            <!-- ===== 快捷键设置 ===== -->
            <TextBlock Text="{DynamicResource Lang_Hotkeys_Title}" Style="{StaticResource SectionHeader}"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 开关热键 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Lang_Hotkey_Switch}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Name="TxtHotkeySwitch" IsReadOnly="True" 
                             PreviewKeyDown="Hotkey_PreviewKeyDown" 
                             GotFocus="Hotkey_GotFocus" LostFocus="Hotkey_LostFocus"
                             Cursor="Hand" Text="Alt + Q" Background="White" Height="30"
                             VerticalContentAlignment="Center" Padding="8,0"
                             BorderBrush="#DDD"/>
                </StackPanel>

                <!-- 设置面板热键 -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Lang_Hotkey_Settings}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Name="TxtHotkeySettings" IsReadOnly="True" 
                             PreviewKeyDown="Hotkey_PreviewKeyDown" 
                             GotFocus="Hotkey_GotFocus" LostFocus="Hotkey_LostFocus"
                             Cursor="Hand" Text="Alt + S" Background="White" Height="30"
                             VerticalContentAlignment="Center" Padding="8,0"
                             BorderBrush="#DDD"/>
                </StackPanel>
            </Grid>

            <!-- ===== 个性化 ===== -->
            <TextBlock Text="{DynamicResource Lang_Personalization_Title}" Style="{StaticResource SectionHeader}"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 语言选择 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Lang_Label_Language}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Name="CboLanguage" SelectionChanged="CboLanguage_SelectionChanged" 
                              Background="White" Height="30" BorderBrush="#DDD">
                        <ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem>
                        <ComboBoxItem Tag="en-US">English</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- 光棒颜色 -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Lang_Label_Color}" Style="{StaticResource FieldLabel}"/>
                    <xctk:ColorPicker Name="ColorPicker" Height="30" 
                                      DisplayColorAndName="False"
                                      ShowStandardColors="True"
                                      ShowAvailableColors="True"
                                      UsingAlphaChannel="False"
                                      SelectedColorChanged="ColorPicker_SelectedColorChanged" />
                </StackPanel>
            </Grid>

            <!-- 荧光棒尺寸设置 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 宽度设置 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="荧光棒宽度" Style="{StaticResource FieldLabel}"/>
                    <xctk:IntegerUpDown Name="NumGlowWidth" 
                                        Minimum="5" Maximum="50" 
                                        Increment="1" 
                                        Height="30"
                                        ValueChanged="NumGlowSize_ValueChanged"/>
                </StackPanel>

                <!-- 高度设置 -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="荧光棒高度" Style="{StaticResource FieldLabel}"/>
                    <xctk:IntegerUpDown Name="NumGlowHeight" 
                                        Minimum="50" Maximum="500" 
                                        Increment="10" 
                                        Height="30"
                                        ValueChanged="NumGlowSize_ValueChanged"/>
                </StackPanel>
            </Grid>

            <CheckBox Name="ChkAutoStart" Content="{DynamicResource Lang_Chk_AutoStart}" Margin="0,0,0,16"
                      Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"
                      Foreground="#444" FontSize="11.5" VerticalContentAlignment="Center"/>

            <Separator Background="#EBEBEB" Margin="0,0,0,14"/>

            <!-- ===== 底部保存按钮 ===== -->
            <Button Content="{DynamicResource Lang_Btn_Save}" 
                    FontWeight="SemiBold" FontSize="13" Height="38"
                    Background="#222" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="BtnSave_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
